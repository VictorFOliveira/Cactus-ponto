COMPOSE_PROJECT_NAME=cactus-ponto-prd
BIND_ADDRESS=127.0.0.1
API_HOST_PORT=3336
WEB_HOST_PORT=8083

POSTGRES_PASSWORD=cactus_dev
JWT_SECRET=troque-por-um-segredo-forte-com-mais-de-32-caracteres
MFA_ENCRYPTION_KEY=troque-por-outra-chave-aleatoria-com-32-caracteres-ou-mais
REQUIRE_ADMIN_MFA=true
CORS_ORIGINS=http://localhost:8083
VITE_API_URL=/api

# Redis - cache e rate limit distribuído
REDIS_URL=redis://redis:6379
REDIS_PREFIX=cactus:ponto
CACHE_TTL_BRANDING=120
CACHE_TTL_DOMAIN=120
CACHE_TTL_DASHBOARD=20

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cactus Ponto <no-reply@seu-dominio.com.br>

# Asaas - use Sandbox até homologar todo o fluxo
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=troque-por-token-webhook-com-32-caracteres-ou-mais
CACTUS_PONTO_PLAN_NAME=STANDARD
CACTUS_PONTO_PLAN_PRICE=0
BILLING_SUSPEND_ON_OVERDUE=true

RATE_LIMIT_API=240
RATE_LIMIT_USER=180
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUNCH=4

# Domínios por empresa
CACTUS_PONTO_BASE_DOMAIN=ponto.cactustecnologia.com.br
CACTUS_PONTO_CUSTOM_CNAME=custom.ponto.cactustecnologia.com.br
CACTUS_PONTO_PUBLIC_SCHEME=https
