PORT=3333
NODE_ENV=development
DATABASE_URL=postgres://cactus:cactus@db:5432/cactus_ponto

# Obrigatório em produção: gere um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=change-me-with-a-long-random-secret

# Origens web permitidas, separadas por vírgula. Obrigatório em produção.
# Ex.: https://ponto.cactustecnologia.com.br,https://cliente.exemplo.com.br
CORS_ORIGINS=

RATE_LIMIT_API=240
RATE_LIMIT_USER=180
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUNCH=4
