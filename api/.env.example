PORT=3333
NODE_ENV=development
DATABASE_URL=postgres://cactus:cactus@db:5432/cactus_ponto

# Redis opcional; sem ele a API faz fallback para banco/memória
REDIS_URL=redis://redis:6379
REDIS_PREFIX=cactus:ponto
CACHE_TTL_BRANDING=120
CACHE_TTL_DOMAIN=120
CACHE_TTL_DASHBOARD=20

# Segurança
JWT_SECRET=change-me-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_API=240
RATE_LIMIT_USER=180
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUNCH=4

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cactus Ponto <no-reply@seu-dominio.com.br>

# Asaas
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=troque-por-token-webhook-com-32-caracteres-ou-mais
CACTUS_PONTO_PLAN_NAME=STANDARD
CACTUS_PONTO_PLAN_PRICE=0
BILLING_SUSPEND_ON_OVERDUE=true
